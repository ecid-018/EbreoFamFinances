# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored (matches *.local) — never commit real values.
# In production (Vercel), set these same names as Project Environment Variables.

# Supabase project settings (Dashboard → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOTE: the household login emails used to live here as VITE_DADDY_EMAIL /
# VITE_MOMMY_EMAIL. They were removed because every VITE_ value is baked into
# the public JS bundle at build time. Each member now types their email once
# per device and it is remembered in localStorage (src/data/deviceProfiles.js).

# Brandfetch logo CDN client ID (brandfetch.com) — used to fetch real
# bank/e-wallet logos for accounts without a hand-picked local asset.
VITE_BRANDFETCH_CLIENT_ID=
