# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored (matches *.local) — never commit real values.
# In production (Vercel), set these same four names as Project Environment Variables.

# Supabase project settings (Dashboard → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Login emails for the two household users — not secrets (they're usernames,
# not passwords), but kept out of git as a matter of not publishing personal
# emails in a public repo's history.
VITE_DADDY_EMAIL=
VITE_MOMMY_EMAIL=
